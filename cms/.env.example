# Strapi CMS environment variables.
# Copy this file to cms/.env and fill in real values. Never commit .env.
# Generate strong random secrets with: openssl rand -base64 32

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
HOST=0.0.0.0
PORT=1337

# ---------------------------------------------------------------------------
# Admin / security keys (REQUIRED — generate real random values, e.g.
#   openssl rand -base64 32   for each key below)
# ---------------------------------------------------------------------------
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified
# Admin session timeout — JWT expiry in seconds (SRS §7.3: 30 minutes).
# Default is 24h if unset; override to 1800 (30 min) for production.
ADMIN_JWT_EXPIRATION=1800

# ---------------------------------------------------------------------------
# Database — PostgreSQL
# ---------------------------------------------------------------------------
# Local dev defaults match docker-compose.yml (npm run db:up), so a fresh
# checkout works without changing anything. Cloud-ready: in production set
# DATABASE_HOST/PORT/NAME/USERNAME/PASSWORD (or DATABASE_URL) to your managed
# Postgres and set DATABASE_SSL=true.
DATABASE_CLIENT=postgres
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=himam
DATABASE_USERNAME=himam
DATABASE_PASSWORD=himam_dev_pw
DATABASE_SCHEMA=public
# Set to true when connecting to cloud-managed Postgres (RDS, Neon, Supabase, …)
DATABASE_SSL=false

# ---------------------------------------------------------------------------
# Contact form email notification (optional)
# ---------------------------------------------------------------------------
# Submissions are always stored in Strapi (admin -> Content Manager -> Contact
# Submission). To ALSO email the team when a lead lands, install a provider
# SDK in cms/ and set these vars — see the `notifyTeam` doc comment in
# cms/src/api/contact-submission/controllers/contact-submission.ts for the
# exact wiring. Leave unset to skip emailing (leads are still stored).
# CONTACT_NOTIFY_EMAIL=team@himam.dev
# EMAIL_FROM=no-reply@himam.dev
# EMAIL_PROVIDER_API_KEY=tobemodified

# ---------------------------------------------------------------------------
# Demo content
# ---------------------------------------------------------------------------
# On first boot, the bootstrap hook seeds demo content (services, team
# members, accomplishments, metrics, values, testimonials, faqs, blog posts —
# all published) and grants the public role read-only access to those APIs.
# Set to `false` to disable seeding (e.g. in production). Safe to leave
# enabled in dev — seeding is skipped when a collection already has content.
SEED_DEMO_CONTENT=true
